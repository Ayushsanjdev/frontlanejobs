# Copy this file to .env.local for local development; configure the same keys in your hosting dashboard.
# Generate at least 32 random bytes in your credential manager before enabling public job reads.
PUBLIC_READ_LIMIT_SALT=
# Never commit the real .env.local. Explore collections require no additional environment variables.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
DATABASE_URL=postgresql://frontlane:CHANGE_ME@localhost:5432/frontlane
# For managed PostgreSQL, enable valid-certificate TLS as required by the provider.
DB_SSL=false
DB_POOL_SIZE=5
# Separate random secrets, each at least 32 characters.
INGEST_TOKEN=
CRON_SECRET=
# Server-only Brave Web Search key. Discovery caps attempts at 30/day and 1,000/month (UTC).
BRAVE_SEARCH_API_KEY=
# Mobile ID tokens must target this web OAuth client; defaults to AUTH_GOOGLE_ID.
MOBILE_GOOGLE_AUDIENCE=

# Optional daily email digests: resend (verified domain) or gmail (no custom domain).
EMAIL_PROVIDER=resend
GMAIL_USER=
# A Google app password, never the account password. Requires two-step verification.
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Disable anonymous aggregate product metrics when required.
DISABLE_PRODUCT_METRICS=false

# Canonical HTTPS notification-link origin (optional; defaults to APP_URL).
# For local HTTP development, use the HTTPS production/staging origin.
NOTIFICATION_APP_URL=
# Generate one stable VAPID pair; share it with the deployment environment.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://frontlanejobs.vercel.app
